# Display name for the project
PROJECT_NAME=Family Bot

# Runtime environment (local, staging, production)
ENVIRONMENT=local

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL where Telegram should send webhook updates
TELEGRAM_WEBHOOK_URL=

# Secret token used to verify incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# Base URL for the Telegram Bot API server
TELEGRAM_API_SERVER=https://api.telegram.org

# Default LLM provider (gemini, openai, openrouter, grok)
LLM_PROVIDER=gemini

# API key for Google Gemini / Google GenAI
GOOGLE_API_KEY=

# API key for OpenAI
OPENAI_API_KEY=

# API key for OpenRouter
OPENROUTER_API_KEY=

# API key for xAI Grok
GROK_API_KEY=

# Model used for text-to-speech generation
TTS_MODEL=gemini-2.5-flash-preview-tts

# Voice used for TTS replies
TTS_VOICE=Charon

# Whether to automatically generate voice replies for stories
ENABLE_TTS_FOR_STORIES=true

# Maximum number of conversation turns to retain in agent memory
HISTORY_MAX_TURNS=12

# Maximum number of messages a user can send per minute
RATE_LIMIT_PER_MINUTE=20

# JSON mapping of Telegram user IDs to display names
FAMILY_MEMBER_NAMES={}
